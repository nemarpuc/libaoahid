set(PACKAGE_VERSION "@PROJECT_VERSION@")
set(PACKAGE_VERSION_COMPATIBLE FALSE)
set(PACKAGE_VERSION_EXACT FALSE)
set(PACKAGE_VERSION_UNSUITABLE FALSE)

# Before 1.0.0 a change of the minor number may break the API and the ABI, so a 0.x request is
# met by the same minor number only.
if(@PROJECT_VERSION_MAJOR@ EQUAL 0)
  set(_AOAHID_MINOR_FIND "${PACKAGE_FIND_VERSION_MINOR}")
  if(PACKAGE_FIND_VERSION_RANGE)
    set(_AOAHID_MINOR_FIND "${PACKAGE_FIND_VERSION_MIN_MINOR}")
  endif()
  set(_AOAHID_MINOR_OK FALSE)
  if(_AOAHID_MINOR_FIND EQUAL @PROJECT_VERSION_MINOR@)
    set(_AOAHID_MINOR_OK TRUE)
  endif()
else()
  set(_AOAHID_MINOR_OK TRUE)
endif()

if(PACKAGE_FIND_VERSION_RANGE)
  set(_AOAHID_VERSION_IN_RANGE TRUE)
  if(PACKAGE_VERSION VERSION_LESS PACKAGE_FIND_VERSION_MIN)
    set(_AOAHID_VERSION_IN_RANGE FALSE)
  endif()
  if(PACKAGE_FIND_VERSION_RANGE_MAX STREQUAL "EXCLUDE")
    if(NOT PACKAGE_VERSION VERSION_LESS PACKAGE_FIND_VERSION_MAX)
      set(_AOAHID_VERSION_IN_RANGE FALSE)
    endif()
  elseif(PACKAGE_VERSION VERSION_GREATER PACKAGE_FIND_VERSION_MAX)
    set(_AOAHID_VERSION_IN_RANGE FALSE)
  endif()
  if(_AOAHID_VERSION_IN_RANGE AND _AOAHID_MINOR_OK AND
     PACKAGE_FIND_VERSION_MIN_MAJOR EQUAL @PROJECT_VERSION_MAJOR@)
    set(PACKAGE_VERSION_COMPATIBLE TRUE)
  endif()
  unset(_AOAHID_VERSION_IN_RANGE)
elseif(PACKAGE_FIND_VERSION_MAJOR EQUAL @PROJECT_VERSION_MAJOR@ AND _AOAHID_MINOR_OK AND
       NOT PACKAGE_FIND_VERSION VERSION_GREATER PACKAGE_VERSION)
  set(PACKAGE_VERSION_COMPATIBLE TRUE)
  if(PACKAGE_FIND_VERSION VERSION_EQUAL PACKAGE_VERSION)
    set(PACKAGE_VERSION_EXACT TRUE)
  endif()
endif()

unset(_AOAHID_MINOR_FIND)
unset(_AOAHID_MINOR_OK)

if(DEFINED CMAKE_SIZEOF_VOID_P AND NOT "${CMAKE_SIZEOF_VOID_P}" STREQUAL "" AND
   NOT "${CMAKE_SIZEOF_VOID_P}" STREQUAL "@CMAKE_SIZEOF_VOID_P@")
  set(PACKAGE_VERSION "${PACKAGE_VERSION} (@CMAKE_SIZEOF_VOID_P@-byte pointers)")
  set(PACKAGE_VERSION_UNSUITABLE TRUE)
endif()
