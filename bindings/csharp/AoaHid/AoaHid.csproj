<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>AoaHid</PackageId>
    <Version>4.2.0</Version>
    <Authors>libaoahid contributors</Authors>
    <Copyright>Copyright (c) 2026 libaoahid contributors</Copyright>
    <Description>Literal P/Invoke declarations for libaoahid; requires a separately installed, version-matched native libaoahid shared library and libusb runtime.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/nemarpuc/libaoahid</PackageProjectUrl>
    <RepositoryUrl>https://github.com/nemarpuc/libaoahid</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>android;aoa;hid;pinvoke;native</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="../../../LICENSE" Pack="true" PackagePath="\" Link="LICENSE" />
  </ItemGroup>
</Project>
